# Public application origin. Do not include a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Both tracks use a host-safe 4 MiB upload limit.
# free-demo additionally shows a visible MVP demo banner.
NEXT_PUBLIC_DEPLOYMENT_TRACK=production

# Supabase browser-safe connection values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Server-only Supabase key. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Local Supabase Google provider values used by supabase/config.toml.
# Configure hosted Supabase providers in their dashboards instead.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=replace-with-google-client-id
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=replace-with-google-client-secret

# The only Google email that admin:sync may activate as administrator.
ADMIN_GOOGLE_EMAIL=designer@example.com

# Stripe test-mode values for local development.
STRIPE_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Optional transactional email. Leave RESEND_API_KEY empty to disable sending.
RESEND_API_KEY=
EMAIL_FROM=Veyra Atelier <projects@example.com>
ADMIN_NOTIFICATION_EMAIL=designer@example.com

# Business rules. Production deployments must set these explicitly.
BUSINESS_TIMEZONE=UTC
DEFAULT_CURRENCY=USD
DELIVERABLE_ALLOWED_HOSTS=www.dropbox.com,dropbox.com

# Stable across simultaneously active production instances.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
