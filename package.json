{
  "name": "veyra-atelier",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run clean:types",
    "start": "next start",
    "typegen": "next typegen",
    "pretypegen": "npm run clean:types",
    "clean:types": "tsx scripts/clean-next-types.ts",
    "typecheck": "npm run typegen && tsc --noEmit",
    "check:public-dependencies": "tsx scripts/check-public-dependencies.ts",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:component": "vitest run --config tests/component/vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:rls": "supabase test db",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "admin:sync": "tsx scripts/sync-admin.ts",
    "load:http": "tsx scripts/load-http.ts",
    "load:realtime": "tsx scripts/load-realtime.ts",
    "free:build": "tsx scripts/build-free-demo.ts",
    "free:build:netlify": "tsx scripts/run-netlify-linux.ts build",
    "free:deploy:preview": "tsx scripts/run-netlify-linux.ts preview",
    "free:deploy:production": "tsx scripts/run-netlify-linux.ts production",
    "verify": "npm run format:check && npm run check:public-dependencies && npm run lint && npm run typecheck && npm run test:coverage && npm run test:component && npm run test:integration && npm run build",
    "verify:full": "npm run verify && npm run test:rls && npm run test:e2e",
    "audit:dependencies": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=22.14.0 <27",
    "npm": ">=10"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.21",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "file-type": "22.1.1",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.88.0",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "stripe": "22.6.2",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@netlify/plugin-nextjs": "5.16.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "jsdom": "29.0.0",
    "netlify-cli": "27.8.0",
    "prettier": "3.9.7",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "type": "module"
}
